# =============================================================================
# deploy/cipherbox-server.service — systemd 自启单元样例（Ubuntu/Linux）
#
# ⚠️⚠️ 路径必须与实际部署位置一致！
# 本单元内三处路径（WorkingDirectory、Environment 的 HMAC 密钥、ExecStart）
# 默认假定仓库部署在 /opt/cipherbox。部署在别处（如家目录）时，安装前先批量
# 替换为实际路径，否则服务起不来（status=203/EXEC 或找不到密钥文件）：
#
#   cd <你的仓库位置>
#   sudo sed -i "s|/opt/cipherbox|$PWD|g" deploy/cipherbox-server.service
#
# User=/Group= 默认注释（服务以 root 运行，不推荐）。生产请取消注释并改为
# 拥有该目录的账户（布局 B = cipherbox 服务账户；家目录布局 A = 你的部署用户）。
#
# 安装：
#   sudo cp deploy/cipherbox-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cipherbox-server
#   systemctl status cipherbox-server
#   journalctl -u cipherbox-server -f          # 跟日志
#
# 停止/禁用:
#   sudo systemctl disable --now cipherbox-server
# =============================================================================
[Unit]
Description=CipherBox key/audit server (HTTPS 8443)
After=network.target

[Service]
Type=simple
# 建议先把仓库部署到 /opt/cipherbox 并创建专用账户（todo 20⑥ 精神）：
#   sudo useradd -r -s /usr/sbin/nologin cipherbox
#   sudo chown -R cipherbox:cipherbox /opt/cipherbox
# 然后取消下面两行注释：
# User=cipherbox
# Group=cipherbox
WorkingDirectory=/opt/cipherbox
Environment=CIPHERBOX_HMAC_KEY_FILE=/opt/cipherbox/server/audit-hmac.key
ExecStart=/opt/cipherbox/server/.venv/bin/python -m uvicorn server.app:create_app --factory --host 0.0.0.0 --port 8443 --ssl-certfile server/certs/server.crt --ssl-keyfile server/certs/server.key
Restart=on-failure
RestartSec=3
# 基础加固
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
